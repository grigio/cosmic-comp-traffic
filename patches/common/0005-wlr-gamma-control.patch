+
+/// A linear ramp: `len` entries from 0 to `u16::MAX`, i.e. no colour change.
+fn identity_gamma(len: usize) -> Vec<u16> {
+    let last = len.saturating_sub(1).max(1) as u64;
+    (0..len)
+        .map(|i| (u16::MAX as u64 * i as u64 / last) as u16)
+        .collect()
+}
