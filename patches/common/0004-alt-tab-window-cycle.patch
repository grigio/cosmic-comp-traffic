+/// How long an Alt+Tab cycle stays open: presses closer together than this walk
+/// the order captured by the first press, a later press starts a new cycle.
+const WINDOW_CYCLE_TIMEOUT: Duration = Duration::from_secs(3);
+
+/// Order of the windows of an in-progress Alt+Tab cycle, kept per seat.
+///
+/// Focusing a window raises it, so the stacking order of the workspace changes
+/// after every step; reusing the order from the first press is what makes
+/// repeated presses visit every window instead of bouncing between two.
+#[derive(Default)]
+struct WindowCycle(Mutex<Option<WindowCycleState>>);
+
+struct WindowCycleState {
+    order: Vec<KeyboardFocusTarget>,
+    index: usize,
+    last: Instant,
+}
+
+fn has_surface(targets: &[KeyboardFocusTarget], target: &KeyboardFocusTarget) -> bool {
+    target.active_window().is_some_and(|window| {
+        targets
+            .iter()
+            .any(|other| other.active_window().as_ref() == Some(&window))
+    })
+}
